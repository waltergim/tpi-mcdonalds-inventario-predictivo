<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
<bpmn:collaboration id="Collaboration_1">
<bpmn:participant id="Pool_McD" name="McDonald's - Local" processRef="Process_McD"/>
<bpmn:participant id="Pool_Prov" name="Proveedor (externo)" processRef="Process_Prov"/>
<bpmn:messageFlow id="M1" name="Orden de compra" sourceRef="T3" targetRef="P1"/>
<bpmn:messageFlow id="M2" name="Orden de compra" sourceRef="T4" targetRef="P1"/>
<bpmn:messageFlow id="M3" name="Pedido despachado" sourceRef="P2" targetRef="D1s"/>
</bpmn:collaboration>
<bpmn:process id="Process_McD" isExecutable="false"><bpmn:laneSet id="LaneSet_1">
<bpmn:lane id="Lane_Sis" name="Sistema (automatizado)"><bpmn:flowNodeRef>S1</bpmn:flowNodeRef><bpmn:flowNodeRef>T1</bpmn:flowNodeRef><bpmn:flowNodeRef>G1</bpmn:flowNodeRef><bpmn:flowNodeRef>E1</bpmn:flowNodeRef><bpmn:flowNodeRef>T2</bpmn:flowNodeRef><bpmn:flowNodeRef>G2</bpmn:flowNodeRef><bpmn:flowNodeRef>T3</bpmn:flowNodeRef><bpmn:flowNodeRef>E4</bpmn:flowNodeRef><bpmn:flowNodeRef>T6</bpmn:flowNodeRef><bpmn:flowNodeRef>E2</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="Lane_Comp" name="Responsable de Compras"><bpmn:flowNodeRef>T4</bpmn:flowNodeRef><bpmn:flowNodeRef>E5</bpmn:flowNodeRef><bpmn:flowNodeRef>T7</bpmn:flowNodeRef><bpmn:flowNodeRef>E3</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="Lane_Dep" name="Encargado de Depósito"><bpmn:flowNodeRef>D1s</bpmn:flowNodeRef><bpmn:flowNodeRef>D1</bpmn:flowNodeRef><bpmn:flowNodeRef>G3</bpmn:flowNodeRef><bpmn:flowNodeRef>D2</bpmn:flowNodeRef></bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="S1" name="Cada hora"><bpmn:outgoing>F1</bpmn:outgoing><bpmn:timerEventDefinition id="S1_d"/></bpmn:startEvent>
<bpmn:task id="T1" name="Calcular stock por lote y demanda proyectada (2 h)"><bpmn:incoming>F1</bpmn:incoming><bpmn:outgoing>F2</bpmn:outgoing></bpmn:task>
<bpmn:exclusiveGateway id="G1" name="¿Stock &lt; umbral crítico?"><bpmn:incoming>F2</bpmn:incoming><bpmn:outgoing>F3</bpmn:outgoing><bpmn:outgoing>F4</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="E1" name="Sin acción"><bpmn:incoming>F4</bpmn:incoming></bpmn:endEvent>
<bpmn:task id="T2" name="Generar orden de compra (estado Pendiente)"><bpmn:incoming>F3</bpmn:incoming><bpmn:outgoing>F5</bpmn:outgoing></bpmn:task>
<bpmn:exclusiveGateway id="G2" name="¿Proveedor con integración digital?"><bpmn:incoming>F5</bpmn:incoming><bpmn:outgoing>F6</bpmn:outgoing><bpmn:outgoing>F8</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:task id="T3" name="Enviar orden automáticamente (estado Enviada)"><bpmn:incoming>F6</bpmn:incoming><bpmn:outgoing>F7</bpmn:outgoing></bpmn:task>
<bpmn:endEvent id="E4" name="Orden enviada"><bpmn:incoming>F7</bpmn:incoming></bpmn:endEvent>
<bpmn:task id="T4" name="Enviar orden por e-mail y registrar el envío"><bpmn:incoming>F8</bpmn:incoming><bpmn:outgoing>F9</bpmn:outgoing></bpmn:task>
<bpmn:endEvent id="E5" name="Orden enviada"><bpmn:incoming>F9</bpmn:incoming></bpmn:endEvent>
<bpmn:task id="T7" name="Reclamar al proveedor y emitir nuevo pedido"><bpmn:incoming>F15</bpmn:incoming><bpmn:outgoing>F16</bpmn:outgoing></bpmn:task>
<bpmn:endEvent id="E3" name="Reclamo gestionado"><bpmn:incoming>F16</bpmn:incoming></bpmn:endEvent>
<bpmn:startEvent id="D1s" name="Llega la entrega"><bpmn:outgoing>F10</bpmn:outgoing><bpmn:messageEventDefinition id="D1s_d"/></bpmn:startEvent>
<bpmn:task id="D1" name="Recibir y controlar la mercadería"><bpmn:incoming>F10</bpmn:incoming><bpmn:outgoing>F11</bpmn:outgoing></bpmn:task>
<bpmn:exclusiveGateway id="G3" name="¿Mercadería conforme?"><bpmn:incoming>F11</bpmn:incoming><bpmn:outgoing>F12</bpmn:outgoing><bpmn:outgoing>F14</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:task id="D2" name="Rechazar entrega y marcar orden Cancelada"><bpmn:incoming>F14</bpmn:incoming><bpmn:outgoing>F15</bpmn:outgoing></bpmn:task>
<bpmn:task id="T6" name="Registrar lote con vencimiento y actualizar stock (orden Recibida)"><bpmn:incoming>F12</bpmn:incoming><bpmn:outgoing>F13</bpmn:outgoing></bpmn:task>
<bpmn:endEvent id="E2" name="Reposición completada"><bpmn:incoming>F13</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="F1" sourceRef="S1" targetRef="T1"/>
<bpmn:sequenceFlow id="F2" sourceRef="T1" targetRef="G1"/>
<bpmn:sequenceFlow id="F3" name="Sí" sourceRef="G1" targetRef="T2"/>
<bpmn:sequenceFlow id="F4" name="No" sourceRef="G1" targetRef="E1"/>
<bpmn:sequenceFlow id="F5" sourceRef="T2" targetRef="G2"/>
<bpmn:sequenceFlow id="F6" name="Sí" sourceRef="G2" targetRef="T3"/>
<bpmn:sequenceFlow id="F7" sourceRef="T3" targetRef="E4"/>
<bpmn:sequenceFlow id="F8" name="No" sourceRef="G2" targetRef="T4"/>
<bpmn:sequenceFlow id="F9" sourceRef="T4" targetRef="E5"/>
<bpmn:sequenceFlow id="F10" sourceRef="D1s" targetRef="D1"/>
<bpmn:sequenceFlow id="F11" sourceRef="D1" targetRef="G3"/>
<bpmn:sequenceFlow id="F12" name="Sí" sourceRef="G3" targetRef="T6"/>
<bpmn:sequenceFlow id="F13" sourceRef="T6" targetRef="E2"/>
<bpmn:sequenceFlow id="F14" name="No" sourceRef="G3" targetRef="D2"/>
<bpmn:sequenceFlow id="F15" sourceRef="D2" targetRef="T7"/>
<bpmn:sequenceFlow id="F16" sourceRef="T7" targetRef="E3"/>
</bpmn:process>
<bpmn:process id="Process_Prov" isExecutable="false">
<bpmn:task id="P1" name="Recibir orden de compra"><bpmn:outgoing>F17</bpmn:outgoing></bpmn:task>
<bpmn:task id="P2" name="Preparar y despachar el pedido"><bpmn:incoming>F17</bpmn:incoming></bpmn:task>
<bpmn:sequenceFlow id="F17" sourceRef="P1" targetRef="P2"/>
</bpmn:process>
